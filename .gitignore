# personal sheet music library and runtime data — never committed
library/
config/
*.pdf
*.zip

# ...except the engraved test fixtures, which exist precisely so the
# extraction tests do not need anybody's personal library. They are engraved
# from the MusicXML beside them by server/tools/tab_extract/engrave_fixtures.py.
!server/tests/fixtures/engraved/*.pdf

# python
__pycache__/
*.pyc
.venv/
dist/
*.egg-info/

# node / frontend
node_modules/
web/dist/
web/public/font/
web/public/soundfont/
# left behind by older checkouts that copied the runtime assets by hand
web/public/alphatab/

# browser test output (traces on failure, the html report)
web/test-results/
web/playwright-report/
web/blob-report/

# editors / os
.DS_Store
Thumbs.db
